DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=
DB_PASSWORD=
DB_DATABASE=arca_dev

PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# --- Rate limiting ---
# De qué proxy se acepta la IP real del cliente (cabecera X-Forwarded-For).
# 'loopback' (por defecto) confía solo en un proxy de la misma máquina, como el
# de cPanel. No poner 'true': cualquiera podría inventar su IP y saltarse el
# límite. Valores posibles: loopback | false | una IP o subred | número de saltos.
TRUST_PROXY=loopback

# --- ClaveÚnica (HU-12) ---
# Credenciales entregadas por la Secretaría de Gobierno Digital vía CeroFilas.
# Se entregan TRES pares: sandbox, QA y produccion. Nunca escribirlas en el codigo
# fuente: la certificacion exige que vivan en variables de entorno.
CLAVE_UNICA_CLIENT_ID=
CLAVE_UNICA_CLIENT_SECRET=
# Debe coincidir exactamente con la URI registrada en CeroFilas.
# ClaveUnica NO permite localhost: para desarrollo hay que usar el dominio del tunel.
CLAVE_UNICA_REDIRECT_URI=http://localhost:3000/api/auth/clave-unica/callback
# URI de retorno tras cerrar sesion en ClaveUnica. Opcional, pero debe estar
# registrada como Logout URI en CeroFilas: si no lo esta, ClaveUnica cierra la
# sesion pero no devuelve a la persona al sitio.
CLAVE_UNICA_LOGOUT_REDIRECT_URI=http://localhost:5173/login
# Clave secreta con la que se deriva el identificador del ciudadano a partir de su
# RUN (HMAC-SHA256). El RUN NO se guarda: solo esta derivacion.
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# CRITICO: si se pierde o se cambia, nadie vuelve a ser reconocido y todos pierden
# su historial. Respaldar junto con las credenciales, nunca versionar.
CLAVE_UNICA_PEPPER=
